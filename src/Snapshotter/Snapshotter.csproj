<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 covers .NET Framework 4.6.1 and later; net8.0 uses the in-box System.Text.Json. -->
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <PackageId>Snapshotter</PackageId>
    <Description>Snapshot testing for .NET that works with any test framework, or none.</Description>
    <PackageTags>snapshot;testing;approval;golden-master</PackageTags>
    <Authors>Snapshotter contributors</Authors>
    <Copyright>Copyright (c) 2026 Snapshotter contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/alpha-software-solutions/snapshotter</PackageProjectUrl>
    <RepositoryUrl>https://github.com/alpha-software-solutions/snapshotter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\nugets</PackageOutputPath>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="PolySharp" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Snapshotter.Tests" />

    <None Include="build\Snapshotter.props" Pack="true" PackagePath="build\;buildTransitive\" />
    <None Include="build\Snapshotter.targets" Pack="true" PackagePath="build\;buildTransitive\" />
    <None Include="..\..\readme.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
