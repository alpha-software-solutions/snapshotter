<Project>
  <!--
  Package versions come from the Verify fork in the submodule. Snapshotter bundles the Verify.dll that
  the fork builds, so it has to declare exactly the dependency versions that assembly was compiled
  against. Importing the fork's list keeps the two from drifting when the submodule moves.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\verify\src\Directory.Packages.props" />
</Project>
