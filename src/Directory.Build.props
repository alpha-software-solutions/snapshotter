<Project>
  <PropertyGroup>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS1591: missing XML comment on a public member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsSnapshotterTestProject Condition="$(MSBuildProjectName.EndsWith('Tests'))">true</IsSnapshotterTestProject>
  </PropertyGroup>
  <!-- In this repo the tests reference the project rather than the package, so they import the
       MSBuild file the package brings. -->
  <Import Condition="'$(IsSnapshotterTestProject)' == 'true'"
          Project="$(MSBuildThisFileDirectory)Snapshotter\build\Snapshotter.props" />
</Project>
