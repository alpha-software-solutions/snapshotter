<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Library -->
    <PackageVersion Include="System.Text.Json" Version="11.0.0" />
    <PackageVersion Include="PolySharp" Version="1.13.2" />
    <!-- Build -->
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <!-- Tests: one project per framework, to show the same calls work under each -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.3" />
    <PackageVersion Include="TUnit" Version="1.87.12" />
  </ItemGroup>
</Project>
